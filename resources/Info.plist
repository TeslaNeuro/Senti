<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>What Am I Looking At?</string>
  <key>CFBundleDisplayName</key>
  <string>What Am I Looking At?</string>
  <key>CFBundleIdentifier</key>
  <string>com.senti.what-am-i-looking-at</string>
  <key>CFBundleVersion</key>
  <string>0.1.0</string>

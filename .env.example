#
# Senti — local-first macOS visual assistant
#
# Copy this file to .env and adjust for your machine:
#   cp .env.example .env
#
# Booleans: true / false / 1 / 0 / yes / no (any case).
# Put comments on their own lines — do not append # after a value.
# Duplicate keys: last value wins; Senti logs a warning at startup.
# Full reference: docs/configuration.md

# -----------------------------------------------------------------------------
# Camera
# Qt / AVFoundation capture. Frames stay in memory only.
# -----------------------------------------------------------------------------

# Index in Qt's camera list. 0 is usually the built-in FaceTime camera.
CAMERA_DEVICE=0

# Preferred capture size in pixels. Detection still resizes to YOLO_IMAGE_SIZE.
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720

# Preferred frame rate. Actual FPS depends on lighting and camera mode.
TARGET_FPS=30

# Live frames kept in RAM. Oldest is dropped when full.
FRAME_BUFFER_SIZE=8

# Rolling buffer used to pick the best frame for VLM / OCR analysis.
SELECTION_BUFFER_SIZE=12

# -----------------------------------------------------------------------------
# Detection (YOLO26)
# Weights are stored and loaded from models/<filename>.
# yolo26n.pt is fastest. yolo26s.pt / yolo26m.pt are slower and more accurate.
# -----------------------------------------------------------------------------

# Filename under models/, or an absolute path to a custom checkpoint.
# For MLX, Senti converts this .pt to models/<name>.npz on first launch.
YOLO_MODEL=yolo26n.pt

# Minimum detection score in (0, 1].
YOLO_CONFIDENCE=0.5

# Inference size passed to Ultralytics / yolo-mlx.
YOLO_IMAGE_SIZE=640

# Backend: auto | ultralytics | mlx
#   auto         — Ultralytics + PyTorch, unless YOLO_DEVICE=mlx
#   ultralytics  — always PyTorch (MPS / CPU / CUDA)
#   mlx          — yolo-mlx native Metal
#                  https://github.com/thewebAI/yolo-mlx
#                  pip install "yolo-mlx[tracking,convert]"
YOLO_RUNTIME=auto

# Device: auto | mps | mlx | cpu | cuda | 0
#   auto — Apple Silicon uses PyTorch MPS when runtime is ultralytics
#   mps  — force PyTorch MPS
#   mlx  — force yolo-mlx (same as YOLO_RUNTIME=mlx)
YOLO_DEVICE=auto

# -----------------------------------------------------------------------------
# Tracking
# Stable IDs (#1, #2, …) while an object stays in view.
# -----------------------------------------------------------------------------

TRACKING_ENABLED=true

# bytetrack.yaml | botsort.yaml
TRACKER_TYPE=bytetrack.yaml

# -----------------------------------------------------------------------------
# Scene change and analysis scheduling
# Lower SCENE_CHANGE_THRESHOLD = more sensitive to motion / new objects.
# -----------------------------------------------------------------------------

# Combined visual + object + spatial score in (0, 1].
SCENE_CHANGE_THRESHOLD=0.15

# Consecutive stable frames required before the scene is READY.
STABILITY_FRAMES=10

# Minimum seconds between automatic VLM runs.
VLM_COOLDOWN=5.0

# Describe the scene automatically when it reaches READY.
VLM_AUTO_ANALYZE=true

# Recent Q&A turns kept for follow-ups.
CONVERSATION_MAX_TURNS=8

# After this many new camera frames, follow-ups use a fresh capture.
CONTEXT_STALE_FRAMES=45

# Crop the focused object before a targeted VLM call.
OBJECT_CROP_ENABLED=true

# Padding around the box, as a fraction of bbox size, in [0, 1].
OBJECT_CROP_PADDING=0.15

# -----------------------------------------------------------------------------
# Vision-language model (Ollama, local only)
# Install: https://ollama.com
# Then:    ollama pull gemma4
# -----------------------------------------------------------------------------

# Must match a tag from `ollama list`.
VLM_MODEL=gemma4

# Only ollama is supported.
VLM_RUNTIME=ollama

VLM_BASE_URL=http://localhost:11434

# -----------------------------------------------------------------------------
# OCR (optional)
# On-device EasyOCR. First use downloads language models.
# EasyOCR is CPU-only on Mac — that is expected.
# -----------------------------------------------------------------------------

OCR_ENABLED=false

# Only easyocr is supported.
OCR_RUNTIME=easyocr

# Comma-separated EasyOCR language codes.
OCR_LANGUAGES=en

# Drop lines below this score, in [0, 1].
OCR_MIN_CONFIDENCE=0.4

# Run OCR when the scene becomes READY.
OCR_AUTO_ON_READY=true

# -----------------------------------------------------------------------------
# Text-to-speech (optional)
# auto uses Qt when it exposes the voice, otherwise macOS `say`
# (needed for system voices such as Tessa).
# -----------------------------------------------------------------------------

TTS_ENABLED=false

# auto | qt | say
TTS_RUNTIME=auto

# Speak new answers without clicking Speak.
TTS_AUTO_SPEAK=true

# Speech rate from -1.0 (slow) to 1.0 (fast).
TTS_RATE=0.0

# Volume from 0.0 to 1.0.
TTS_VOLUME=1.0

# Optional macOS voice name substring, e.g. Tessa. Leave empty for the default.
TTS_VOICE=

# Stop current speech when new text arrives.
TTS_INTERRUPT=true

# -----------------------------------------------------------------------------
# Voice input (optional)
# Push-to-talk via faster-whisper. Model loads on first Mic click.
# Requires microphone permission.
# -----------------------------------------------------------------------------

VOICE_ENABLED=false

# Only whisper is supported.
VOICE_RUNTIME=whisper

# tiny | base | small | …  Larger is slower and more accurate.
VOICE_MODEL=base

# Transcription language. Leave empty to let Whisper auto-detect.
VOICE_LANGUAGE=en

# Auto-stop recording after this many seconds.
VOICE_MAX_SECONDS=8.0

# Ignore recordings shorter than this.
VOICE_MIN_SECONDS=0.6

# Capture sample rate in Hz.
VOICE_SAMPLE_RATE=16000

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------

# DEBUG logs and unfiltered third-party warnings.
DEBUG_MODE=false

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

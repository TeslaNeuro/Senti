# Camera
CAMERA_DEVICE=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
TARGET_FPS=30
FRAME_BUFFER_SIZE=8
SELECTION_BUFFER_SIZE=12

# YOLO26 (Phase 2+)
YOLO_MODEL=yolo26s.pt
YOLO_CONFIDENCE=0.65
YOLO_IMAGE_SIZE=640
YOLO_DEVICE=auto

# Tracking (Phase 3+)
TRACKING_ENABLED=true
TRACKER_TYPE=bytetrack.yaml

# Scene change / VLM (Phase 4+)
SCENE_CHANGE_THRESHOLD=0.15
STABILITY_FRAMES=10
VLM_COOLDOWN=5.0
VLM_AUTO_ANALYZE=true
CONVERSATION_MAX_TURNS=8
CONTEXT_STALE_FRAMES=45
OBJECT_CROP_ENABLED=true
OBJECT_CROP_PADDING=0.15


# VLM (Phase 6+)
VLM_MODEL=gemma4
VLM_RUNTIME=ollama
VLM_BASE_URL=http://localhost:11434

# Optional features (later phases)
OCR_ENABLED=true
OCR_RUNTIME=easyocr
OCR_LANGUAGES=en
OCR_MIN_CONFIDENCE=0.4
OCR_AUTO_ON_READY=true
TTS_ENABLED=true
TTS_RUNTIME=auto
TTS_AUTO_SPEAK=false
TTS_RATE=0.0
TTS_VOLUME=1.0
TTS_VOICE=Tessa
TTS_INTERRUPT=true
VOICE_ENABLED=false
VOICE_RUNTIME=whisper
VOICE_MODEL=base
VOICE_LANGUAGE=en
VOICE_MAX_SECONDS=8.0
VOICE_MIN_SECONDS=0.6
VOICE_SAMPLE_RATE=16000

# App
DEBUG_MODE=false
LOG_LEVEL=INFO
